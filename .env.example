# Local config for the kit. Copy it to ".env" and edit only what you need:  cp .env.example .env
#
# No API key is required. The engine is bound to 127.0.0.1 only, and that localhost
# binding is the security boundary, because the engine image has no built-in authentication.

# Host port the engine listens on. Default: 8080. Change it only if 8080 is already taken,
# then run "docker compose up -d" again. Compose and both scripts read it from this file.
# The port inside the container stays 8080.
SCRAPER_PORT=8080

# Full URL of the engine's API. Default: unset, so the scripts use http://localhost:<SCRAPER_PORT>.
# Set it only if the engine runs somewhere else. When set, the scripts ignore SCRAPER_PORT.
# SCRAPER_BASE_URL=http://localhost:8080

# Sent as an X-API-Key header on every request. Default: blank, which is right for local use.
# Set it only if you expose the engine beyond localhost behind an auth proxy (e.g. Caddy or
# nginx checking that header).
SCRAPER_API_KEY=

# Webhook (optional). When set, the "webhook" service POSTs each finished job's CSV here.
# Start it with: docker compose --profile webhook up -d
# The relay runs in a container, so "localhost" there means the container itself:
#   - app on the host: http://host.docker.internal:<port>/... (the app must listen on an address
#     the Docker bridge can reach, not only 127.0.0.1)
#   - app in Docker: put it on the same network and use its service name
WEBHOOK_URL=
# Signs each request: X-Signature: sha256=<hex HMAC-SHA256 of the body>. Set it and check it on the
# receiving side. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=
# Seconds between checks for finished jobs. Default: 15.
# WEBHOOK_INTERVAL=15
